{% set alerts = app_predictive_reorder_alerts() %}

{% if alerts is not empty %}
    <div class="reorder-alerts" data-test="reorder-alerts">
        <h2>À réassortir bientôt</h2>

        <div class="reorder-alerts__list">
            {% for alert in alerts %}
                <div class="reorder-alert" data-test="reorder-alert-item">
                    <div class="reorder-alert__content">
                        <strong class="reorder-alert__product">
                            {{ alert.variant.product.name }}
                            {% if alert.variant.name %}
                                - {{ alert.variant.name }}
                            {% endif %}
                        </strong>
                        <p class="reorder-alert__explanation">{{ alert.explanation }}</p>
                    </div>
                    <form method="post" action="{{ path('tmonier_predictive_shop_prepare_cart', {'variantId': alert.variant.id}) }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('tmonier_predictive_prepare_cart') }}">
                        <button type="submit" class="button" data-test="prepare-cart-button">
                            Préparer le panier
                        </button>
                    </form>
                </div>
            {% endfor %}
        </div>
    </div>
{% endif %}
