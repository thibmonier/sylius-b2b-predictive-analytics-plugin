{% set alerts = tmonier_predictive_reorder_alerts() %}

{% if alerts is not empty %}
    <div class="reorder-alerts" data-test="reorder-alerts">
        <h2>À réassortir bientôt</h2>

        <div class="reorder-alerts__list">
            {% for alert in alerts %}
                <div class="reorder-alert" data-test="reorder-alert-item">
                    <div class="reorder-alert__content">
                        <strong class="reorder-alert__product">
                            {{ alert.variant.product.name }}
                            {% if alert.variant.name %}
                                - {{ alert.variant.name }}
                            {% endif %}
                        </strong>
                        <p class="reorder-alert__explanation">{{ alert.explanation }}</p>
                    </div>
                    {# TODO T-218-04 : bouton "Préparer le panier" #}
                </div>
            {% endfor %}
        </div>
    </div>
{% endif %}
